# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Check the exact IDs at http://localhost:8000/api/models once running.
DEFAULT_MODEL=meta/muse-spark-1.3
# Cheaper while iterating: meta/muse-spark-1.3-contributor

APP_URL=http://localhost:8000
APP_TITLE=Muse Build Day Starter
REQUEST_TIMEOUT_SECONDS=120

# Debate Arena
ARENA_CONCURRENCY=30
ARENA_REASONING_EFFORT=low
ARENA_MAX_AGENTS=2000
